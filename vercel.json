{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/apps/parcelpanel",
      "destination": "https://flexi-knee-store.myshopify.com/apps/parcelpanel"
    },
    {
      "source": "/apps/parcelpanel/:path*",
      "destination": "https://flexi-knee-store.myshopify.com/apps/parcelpanel/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/product/:path*",
      "destination": "/"
    },
    {
      "source": "/guides/:path*",
      "destination": "/"
    },
    {
      "source": "/science",
      "destination": "/"
    },
    {
      "source": "/track-order",
      "destination": "/"
    },
    {
      "source": "/why-flexiknee",
      "destination": "/"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.flexi-knee.com"
        }
      ],
      "destination": "https://flexi-knee.com/:path*",
      "permanent": true
    },
    {
      "source": "/guides/running-shoes-knee-pain-causes-fixes",
      "destination": "/guides/best-running-shoes-knee-pain",
      "permanent": true
    },
    {
      "source": "/guides/running-shoes-knee-pain-discomfort",
      "destination": "/guides/best-running-shoes-knee-pain",
      "permanent": true
    },
    {
      "source": "/guides/post-exercise-knee-pain-guide",
      "destination": "/guides/knee-pain-after-exercise",
      "permanent": true
    },
    {
      "source": "/guides/sore-knees-after-workout",
      "destination": "/guides/knee-pain-after-exercise",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-location-map-2026",
      "destination": "/guides/knee-pain-locations-visual-guide",
      "permanent": true
    },
    {
      "source": "/guides/pain-in-the-knee-causes-locations",
      "destination": "/guides/knee-pain-locations-visual-guide",
      "permanent": true
    },
    {
      "source": "/guides/daily-knee-comfort-routine",
      "destination": "/guides/daily-knee-care-routine",
      "permanent": true
    },
    {
      "source": "/guides/heat-or-ice-knee-pain-situations",
      "destination": "/guides/heat-vs-ice-for-knees",
      "permanent": true
    },
    {
      "source": "/collections/:path*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/products/:handle",
      "destination": "/product/:handle",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blogs/:path*",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/product/flexiknee",
      "destination": "/product/knee-massager-smart-red-light-and-massage-therapy",
      "permanent": true
    }
  ]
}