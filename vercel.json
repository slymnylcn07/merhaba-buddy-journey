{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/product/:path*",
      "destination": "/"
    },
    {
      "source": "/guides/:path*",
      "destination": "/"
    },
    {
      "source": "/science",
      "destination": "/"
    },
    {
      "source": "/track-order",
      "destination": "/"
    },
    {
      "source": "/why-flexiknee",
      "destination": "/"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.flexi-knee.com"
        }
      ],
      "destination": "https://flexi-knee.com/:path*",
      "permanent": true
    }
  ]
}
