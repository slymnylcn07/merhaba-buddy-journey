{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/apps/parcelpanel",
      "destination": "https://flexi-knee-store.myshopify.com/apps/parcelpanel"
    },
    {
      "source": "/apps/parcelpanel/:path*",
      "destination": "https://flexi-knee-store.myshopify.com/apps/parcelpanel/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/guides",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/guides/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/product/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/shop",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/knee-quiz",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/why-flexiknee",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/editorial-team",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/track-order",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/privacy-policy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/terms-of-service",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/refund-policy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/shipping-policy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/editorial-policy",
      "destination": "/editorial-team",
      "permanent": true
    },
    {
      "source": "/science",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/do-knee-massagers-actually-work-guide",
      "destination": "/guides/do-knee-massagers-work",
      "permanent": true
    },
    {
      "source": "/guides/heat-or-ice-knee-pain",
      "destination": "/guides/heat-vs-ice-for-knees",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-hiking",
      "destination": "/guides/knee-pain-when-hiking",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-squatting",
      "destination": "/guides/knee-pain-when-squatting",
      "permanent": true
    },
    {
      "source": "/guides/knee-stiffness-after-resting",
      "destination": "/guides/why-do-my-knees-feel-tight-after-resting",
      "permanent": true
    },
    {
      "source": "/guides/running-shoes-knee-pain",
      "destination": "/guides/best-running-shoes-knee-pain",
      "permanent": true
    },
    {
      "source": "/guides/sharp-knee-pain-causes",
      "destination": "/guides/sharp-knee-pain-causes-relief",
      "permanent": true
    },
    {
      "source": "/guides/what-causes-knee-pain",
      "destination": "/guides/what-causes-knee-pain-guide",
      "permanent": true
    },
    {
      "source": "/guides/running-shoes-knee-pain-causes-fixes",
      "destination": "/guides/best-running-shoes-knee-pain",
      "permanent": true
    },
    {
      "source": "/guides/running-shoes-knee-pain-discomfort",
      "destination": "/guides/best-running-shoes-knee-pain",
      "permanent": true
    },
    {
      "source": "/guides/post-exercise-knee-pain-guide",
      "destination": "/guides/knee-pain-after-exercise",
      "permanent": true
    },
    {
      "source": "/guides/sore-knees-after-workout",
      "destination": "/guides/knee-pain-after-exercise",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-after-exercise-but-not-during",
      "destination": "/guides/knee-pain-after-exercise",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-location-map-2026",
      "destination": "/guides/knee-pain-locations-visual-guide",
      "permanent": true
    },
    {
      "source": "/guides/pain-in-the-knee-causes-locations",
      "destination": "/guides/knee-pain-locations-visual-guide",
      "permanent": true
    },
    {
      "source": "/guides/daily-knee-comfort-routine",
      "destination": "/guides/daily-knee-care-routine",
      "permanent": true
    },
    {
      "source": "/guides/heat-or-ice-knee-pain-situations",
      "destination": "/guides/heat-vs-ice-for-knees",
      "permanent": true
    },
    {
      "source": "/guides/heat-or-ice-knee-pain-science",
      "destination": "/guides/heat-vs-ice-for-knees",
      "permanent": true
    },
    {
      "source": "/guides/clicking-knee-without-pain",
      "destination": "/guides/why-do-my-knees-crack-or-pop",
      "permanent": true
    },
    {
      "source": "/guides/back-of-knee-pain-common",
      "destination": "/guides/back-of-knee-pain-explained",
      "permanent": true
    },
    {
      "source": "/guides/back-of-knee-pain-daily-habits",
      "destination": "/guides/back-of-knee-pain-explained",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-worse-at-night",
      "destination": "/guides/why-do-my-knees-hurt-when-sleeping",
      "permanent": true
    },
    {
      "source": "/guides/side-of-knee-pain-explained",
      "destination": "/guides/side-knee-pain-comfort-guide",
      "permanent": true
    },
    {
      "source": "/guides/side-knee-pain-inner-outer",
      "destination": "/guides/side-knee-pain-comfort-guide",
      "permanent": true
    },
    {
      "source": "/guides/cause-of-knee-pain-patterns",
      "destination": "/guides/what-causes-knee-pain-guide",
      "permanent": true
    },
    {
      "source": "/guides/what-makes-knee-pain-worse",
      "destination": "/guides/what-causes-knee-pain-guide",
      "permanent": true
    },
    {
      "source": "/guides/knee-pain-treatment-daily-habits",
      "destination": "/guides/how-to-fix-knee-pain",
      "permanent": true
    },
    {
      "source": "/guides/it-band-syndrome-explained",
      "destination": "/guides/it-band-pain-location-diagram",
      "permanent": true
    },
    {
      "source": "/guides/sharp-knee-pain-comes-and-goes",
      "destination": "/guides/intermittent-knee-pain-guide",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.flexi-knee.com"
        }
      ],
      "destination": "https://flexi-knee.com/:path*",
      "permanent": true
    }
  ]
}
